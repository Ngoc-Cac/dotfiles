{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",

        "todowrite": "allow",
        "grep": "allow",
        "glob": "allow",
        "read": {
            "*": "allow",

            "*.env": "deny"
        },

        "bash": {
            "*": "ask",

            "git log *": "allow",
            "git reflog *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "git show *": "allow",
            "git blame *": "allow",

            "sort *": "allow",
            "cat *": "allow",
            "echo *": "allow",
            "find *": "allow",
            "head *": "allow",
            "ls *": "allow",
            "rg *": "allow",
            "grep *": "allow",

            "* sudo *": "deny",
            "* rm *": "deny",
            "sudo *": "deny",
            "rm *": "deny"
        }
    }
}
