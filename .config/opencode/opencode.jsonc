{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",

        "todowrite": "allow",
        "glob": "allow",
        "read": {
            "*": "allow",

            "*.env": "deny",
        },

        "bash": {
            "*": "ask",

            "git log *": "allow",
            "git status *": "allow",
            "git diff *": "allow",

            "ls *": "allow",
            "rg *": "allow",
            "grep *": "allow",

            "* sudo *": "deny",
            "* rm *": "deny",
            "sudo *": "deny",
            "rm *": "deny"
        },
    }
}
