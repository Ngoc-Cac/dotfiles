{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "*": "ask",
        "external_directory": {
            "~/.ssh/**": "deny",
            "~/.password-store/**": "deny",
            "~/.gnupg/**": "deny",
            "/tmp/opencode/**": "allow"
        },

        "todowrite": "allow",
        "grep": "allow",
        "glob": "allow",
        "read": {
            "*": "allow",

            "*.env": "deny",
            "*.env.*": "deny",

            // in case I start in .gnupg or .password-store for whatever reason
            "*.pem": "deny",
            "*.key": "deny",
            "*.p12": "deny",
            "*.pfx": "deny",

            "*.kdbx": "deny",
            "*.asc": "deny",
            "*.gpg": "deny"
        },

        "bash": {
            "*": "ask",

            "git log *": "allow",
            "git reflog *": "allow",
            "git status *": "allow",
            "git diff *": "allow",
            "git show *": "allow",
            "git blame *": "allow",

            "basename *": "allow",
            "dirname *": "allow",
            "file *": "allow",
            "du *": "allow",
            "tree *": "allow",
            "find *": "allow",
            "ls *": "allow",

            "cat *": "allow",
            "head *": "allow",
            "tail *": "allow",
            "wc *": "allow",
            "diff *": "allow",

            "rg *": "allow",
            "grep *": "allow",
            "sort *": "allow",
            "uniq *": "allow",
            "cut *": "allow",
            "tr *": "allow",
            "join *": "allow",
            "paste *": "allow",

            "type *": "allow",
            "which *": "allow",

            "printf *": "allow",
            "echo *": "allow",

            "whoami *": "allow",

            "* sudo *": "deny",
            "* rm *": "deny",
            "sudo *": "deny",
            "rm *": "deny"
        }
    }
}
