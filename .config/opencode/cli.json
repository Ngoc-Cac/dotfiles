{
    "$schema": "https://opencode.ai/v2/cli.json",
    "theme": { "name": "gruvbox" },
    "diffs": { "wrap": "word" },
    "cursor": { "blinking": false },
    "animations": true,
    "session": {
        "sidebar": "auto",
        "scrollbar": false,
        "thinking": "hide",
        "verbosity": "high"
    },
    "tabs": {
      "mode": "auto",
      "layout": "horizontal",
      "scope": "global",
      "indicators": "numbers"
    },
    "keybinds": {
        "leader": "ctrl+x",
        "session.delete": "<leader>d",
        "prompt.submit": "ctrl+return",
        "agent.cycle": "tab",
        "queued_prompt.delete": "none",
        "terminal.toggle": "none",
        "session.list": "<leader>o",
        "prompt.stash": "<leader>s",
        "prompt.stash.list": "<leader>l",
        "prompt.stash.pop": "<leader>p",
        "composer.subagent.interrupt": "ctrl+shift+d",
        "composer.shell.kill": "ctrl+shift+d"
    },
    "plugins": [
        {
            "package": "@leohenon/opencode-vim-plugin@beta",
            "options": {
                "vim_initial_mode": "normal",
                "vim_escape_sequence": "kj",
                "vim_system_clipboard_register": true,
                "normal_keybinds": {
                    "ctrl+y": "session.line.up",
                    "ctrl+e": "session.line.down",
                    "ctrl+u": "session.half.page.up",
                    "ctrl+d": "session.half.page.down",
                    "ctrl+b": "session.page.up",
                    "ctrl+f": "session.page.down"
                }
            }
        }
    ]
}
