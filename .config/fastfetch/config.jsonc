{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "source": "arch2"
        // "padding": { "top": 1 }
    },
    "display": {
        "separator": "",
        "constants": [
            "\u001b[56C",  // $1: Move cursor forward, D will move backwards
            "╰────────────────────────────────────────────────────────────────────╯"
            ],
        "key": { "width": 14 }  // set the width of all key
    },
    "modules": [
        // #90 means \u001b[90m
        {
            "type": "custom",
            "format": "╭──────────────────────────────  User  ──────────────────────────────╮",
            "outputColor": "96"
        },
        {
            "type": "title",
            "key": "{#96}│      {#96}User:{$1} {#96}│"
        },
        {
            "type": "uptime",
            "key": "{#96}│    {#96}Uptime:{$1} {#96}│"
        },
        {
            "type": "command",
            "key": "{#96}│   {#96}Startup:{$1} {#96}│",
            "text": "echo $STARTUP_TIME ms"
        },
        {
            "type": "custom",
            "format": "{$2}",
            "outputColor": "96"
        },

        {
            "type": "custom",
            "format": "╭──────────────────────────────  Info  ──────────────────────────────╮",
            "outputColor": "33"
        },
        {
            "type": "os",
            "key": "{#33}│        {#33}OS:{$1} {#33}│"
        },
        {
            "type": "host",
            "key": "{#33}│      {#33}Host:{$1} {#33}│"
        },
        {
            "type": "packages",
            "key": "{#33}│  {#33}Packages:{$1} {#33}│"
        },
        {
            "type": "custom",
            "format": "{$2}",
            "outputColor": "33"
        },

        {
            "type": "custom",
            "format": "╭────────────────────────────  Hardware  ────────────────────────────╮",
            "outputColor": "91"
        },
        {
            "type": "cpu",
            "key": "{#91}│       {#91}CPU:{$1} {#91}│",
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "{#91}│       {#91}GPU:{$1} {#91}│"
        },
        {
            "type": "disk",
            "key": "{#91}│      {#32}Disk:{$1} {#91}│"
        },
        {
            "type": "memory",
            "key": "{#91}│    {#95}Memory:{$1} {#91}│"
        },
        {
            "type": "custom",
            "format": "{$2}",
            "outputColor": "91"
        },

        {
            "type": "terminalfont",
            "key": "Terminal Font:",
            "keyWidth": 16
        },
        // "terminaltheme",
        "colors"
    ]
}
