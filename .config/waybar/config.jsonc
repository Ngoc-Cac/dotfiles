{
    // "reload_style_on_change": true,
    "height": 20,
    "spacing": 4,
    "modules-left": [
        "custom/power",
        // "keyboard-state",

        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [ "idle_inhibitor", "clock" ],
    "modules-right": [
        "hyprland/submap",
        "tray",
        "network",
        "pulseaudio#output",
        "pulseaudio#input",

        "memory",
        "cpu",
        "temperature"
    ],


    "custom/power": {
        "format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend"
		}
    },


    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{icon}{windows} {name}",
        "format-icons": {
            "urgent": " ",
            "focused": " ",
            "default": ""
        },
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": false,
            "format": "{icon}",
            "icon-size": 20
        }
    },


    "mpris": {
        "interval": 1,
        "format": "{player_icon}{dynamic}",
        "format-paused": "{status_icon} {dynamic}",

        "max-length": 70,
        "dynamic-order": ["artist", "title", "album", "position"],
        "dynamic-importance-order": ["title", "artist", "album", "position", "length"],
        "ellipsis": "...",

        "player-icons": {
            "default": " ",
            "spotify": " ",
            "firefox": "󰈹 ",
            "brave": " "
        },
        "status-icons": { "paused": "" }
    },


    "clock": {
        "interval": 1,  // refresh rate (seconds)
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%d/%m/%Y  %H:%M:%S}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "idle_inhibitor": {  // when activated, screen won't sleep
        "format": "{icon}",
        "format-icons": { "activated": " ", "deactivated": " " }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "reverse-direction": true
    },


    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": " ",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol --tab=4"
    },
    "pulseaudio#output": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": "",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "hands-free": "󰂑",
            "default": [ " ", " ", "" ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "network": {
        "format-wifi": "{signalStrength}%  ",
        "format-disconnected": "⚠ ",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{essid}: {ifname} via {gwaddr}"
    },


    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{icon} {name}",
        "format-icons": { "locked": "", "unlocked": "" }
    },


    "cpu": { "format": " {usage}%" },
    "memory": { "format": "{used:0.1f} / {total:0.1f} GiB" },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "warning-threshold": 70,
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰉬", "", "󰉪"]
    }
}
