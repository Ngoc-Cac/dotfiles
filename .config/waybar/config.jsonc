{
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "keyboard-state",
        "hyprland/submap",
        "hyprland/workspaces"
    ],
    "modules-center": [ "mpris" ],
    "modules-right": [
        "idle_inhibitor",
        "tray",
        "pulseaudio",
        "backlight",
        "network",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "battery#bat2",
        "power-profiles-daemon",
        "clock",
        "custom/power"
    ],


    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}: {icon}",
        "format-icons": {
            "1": "Term",
            "2": "Browser",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "hyprland/submap": {
        "format": "<b>{}</b>"
    },


    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} <b>{dynamic}</b>",

        "max-length": 60,
        "dynamic-order": ["artist", "title", "album", "position"],
        "dynamic-importance-order": ["title", "artist", "album", "position", "length"],
        "ellipsis": "...",

        "player-icons": {
            "default": " ",
            "spotify": " ",
            "firefox": "󰈹 ",
            "brave": " "
        },
        "status-icons": { "paused": "" }
    },

    "idle_inhibitor": {  // when activated, screen won't sleep
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" }
    },

    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": { "locked": "", "unlocked": "" }
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰅶 {icon} {format_source}",
        "format-muted": "󰅶 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        // "on-click": "pavucontrol"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },

    "network": {
        // "interface": "wlp2*",  // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M - %Y/%m/%d}",
        "format-alt": "{:%Y-%m-%d}"
    },

    "tray": { "icon-size": 21, "spacing": 10 },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    },


    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰃨",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": { "bat": "BAT2" },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },


    "cpu": { "format": "{usage}% " },
    "memory": {
        "interval": 10,
        "format": "{used:0.1f}GiB / {total:0.1f} GiB"
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰉬", "", "󰉪"]
    }
}
