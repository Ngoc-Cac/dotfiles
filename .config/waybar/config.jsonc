{
    // "reload_style_on_change": true,
    "height": 20,
    "spacing": 4,
    "modules-left": [ "custom/power", "hyprland/workspaces" ],
    "modules-center": [ "idle_inhibitor", "clock" ],
    "modules-right": [
        "hyprland/submap",
        "tray",
        "network",
        "pulseaudio#output",
        "pulseaudio#input",

        "memory",
        "cpu",
        "temperature",
        "custom/nvidia"
    ],


    "custom/power": {
        "format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend"
		}
    },


    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{icon}{windows} {name}",
        "format-icons": {
            "urgent": " ",
            "focused": " ",
            "default": ""
        },
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": false,
            "format": "{icon}",
            "icon-size": 20
        }
    },


    "clock": {
        "interval": 1,  // refresh rate (seconds)
        "tooltip-format": "{calendar}",
        "format": "{:%d/%m/%Y  %H:%M:%S}",
        "format-alt": "{:%H:%M:%S}",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "iso8601": true,
            "format": {
                "months":   "<span color='#abe9b3'>{}</span>",
                "days":     "<span color='#fbf1c7'>{}</span>",
                "weeks":    "<span color='#ffcc66'>W{}</span>",
                "weekdays": "<span color='#ffcc66'>{}</span>",
                "today":    "<span color='#fb4934'>{}</span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },
    "idle_inhibitor": {  // when activated, screen won't sleep
        "format": "{icon}",
        "format-icons": { "activated": " ", "deactivated": " " }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "reverse-direction": true
    },


    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": " ",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol --tab=4"
    },
    "pulseaudio#output": {
        "format": "{volume}% {icon}",
        "format-muted": "󰝟 ",
        "format-bluetooth": "{volume}% {icon}",
        "format-bluetooth-muted": "󰝟 ",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "default": [ "", " ", " " ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "network": {
        "format-wifi": "{signalStrength}%  ",
        "format-disconnected": "⚠ ",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{essid}: {ifname} via {gwaddr}"
    },


    "memory": {
        "interval": 10,
        "format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "cpu": { "format": " {usage}%" },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "warning-threshold": 70,
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰉬", "", "󰉪"]
    },
    "custom/nvidia": {
        "interval": 10,
        "exec": "nvidia-smi --query-gpu=temperature.gpu,memory.used,memory.total --format=csv,nounits,noheader | awk -F', *' '{printf \"{\\\"text\\\":\\\"%d°C\\\", \\\"tooltip\\\":\\\"%.1f / %.1f GiB\\\"}\\n\", $1, $2/1024, $3/1024}'",
        "return-type": "json",
        "format": "󰢮 {}"
    }
}
