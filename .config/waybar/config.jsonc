{
    "reload_style_on_change": true,
    "height": 30,
    "spacing": 4,
    "modules-left": [
        "custom/power",
        "keyboard-state",

        "hyprland/workspaces",
        "hyprland/submap",
        "mpris"
    ],
    "modules-center": [ "clock" ],
    "modules-right": [
        "idle_inhibitor",
        "tray",
        "network",
        "pulseaudio#output",
        "pulseaudio#input",

        "memory",
        "cpu",
        "temperature"
    ],


    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{icon}{windows}{name}",
        "format-icons": {
            "urgent": "",
            "focused": "",
            "default": ""
        },
        "workspace-taskbar": {
            "enable": true,
            "update-active-window": false,
            "format": "{icon} ",
            "icon-size": 20
        }
    },
    "hyprland/submap": { "format": "<b>{}</b>" },


    "mpris": {
        "interval": 1,
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",

        "max-length": 60,
        "dynamic-order": ["artist", "title", "album", "position"],
        "dynamic-importance-order": ["title", "artist", "album", "position", "length"],
        "ellipsis": "...",

        "player-icons": {
            "default": " ",
            "spotify": " ",
            "firefox": "󰈹 ",
            "brave": " "
        },
        "status-icons": { "paused": "" }
    },


    "clock": {
        "interval": 1,  // refresh rate (seconds)
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M:%S - %d/%m/%Y}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "idle_inhibitor": {  // when activated, screen won't sleep
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" }
    },
    "tray": {
        "icon-size": 21,
        "spacing": 10,
        "reverse-direction": true
    },


    "pulseaudio#output": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-bluetooth": "{volume}% ",
        "format-bluetooth-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "default": ["", "", ""]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": " ",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol --tab=4"
    },
    "network": {
        "format-wifi": "   {signalStrength}%",
        "format-disconnected": "  ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format": "{essid}: {ifname} via {gwaddr}"
    },


    "custom/power": {
        "format" : "⏻",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown",
			"reboot": "reboot",
			"suspend": "systemctl suspend"
		}
    },


    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": { "locked": "", "unlocked": "" }
    },


    "cpu": { "format": "  {usage}%" },
    "memory": {
        "interval": 10,
        "format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "temperature": {
        "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon3/temp1_input",
        "warning-threshold": 70,
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["󰉬", "", "󰉪"]
    }
}
