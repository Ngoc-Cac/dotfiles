@import "~/.config/rofi/colorschemes/gruvbox.rasi"

configuration {
    modi        : "drun";
    show-icons  : true;
    display-drun: " ";
}

window {
    width           : 600px;
    border-radius   : 12px;
    border-color    : @selected;
    background-color: @background;
}

mainbox {
    children        : [ "inputbar", "listview" ];
    border-color    : @selected;
    background-color: transparent;
}

inputbar {
    children        : [ "prompt", "entry" ];
    padding         : 20px;
    border-color    : @selected;
    background-color: @selected;
    text-color      : @background;
}

prompt {
    background-color: inherit;
    text-color      : inherit;
}

entry {
    cursor           : text;
    placeholder      : "...";
    placeholder-color: inherit;
    background-color : inherit;
    text-color       : inherit;
}

listview {
    lines           : 8;
    layout          : vertical;
    border-color    : @selected;
    background-color: transparent;
    text-color      : @foreground;
}

element {
    cursor          : pointer;
    spacing         : 10px;
    padding         : 10px;
    border-color    : @selected;
    text-color      : @foreground;
    background-color: transparent;
}
element normal.normal {
    background-color: @background;
    text-color      : @foreground;
}
element selected.normal {
    background-color: @background-alt;
    text-color      : @foreground;
}
element-icon {
    size            : 4ch;
    cursor          : inherit;
    text-color      : inherit;
    background-color: transparent;
}
element-text {
    background-color: transparent;
    text-color      : inherit;
    highlight       : inherit;
    cursor          : inherit;
    vertical-align  : 0.5;
}
